 }
 
+static const u8* sUnknownArrayEnd = nullptr;
+
+// PikminRecomp: GameCube code never tells GXSetArray how large an array is. For arrays set with size 0,
+// scan this draw's indices and grow the uploaded extent to (maxIndex + 1) * stride.
+static void infer_unknown_array_extents(GXVtxFmt fmt, const u8* data, u32 vtxCount, u32 vtxSize) noexcept {
+  const auto& vtxFmt = g_gxState.vtxFmts[fmt];
+  u32 offset = 0;
+  for (int i = GX_VA_PNMTXIDX; i <= GX_VA_TEX7; ++i) {
+    const auto& attrFmt = vtxFmt.attrs[i];
+    const auto desc = g_gxState.vtxDesc[i];
+    const auto attr = static_cast<GXAttr>(i);
+    const u32 count = i == GX_VA_NRM && attrFmt.cnt == GX_NRM_NBT3 ? 3 : 1;
+    u32 size = 0;
+    switch (desc) {
+    case GX_DIRECT:
+      size = comp_type_size(attr, attrFmt.type) * comp_cnt_count(attr, attrFmt.cnt);
+      break;
+    case GX_INDEX8:
+      size = count;
+      break;
+    case GX_INDEX16:
+      size = count * 2;
+      break;
+    default:
+      break;
+    }
+    if ((desc == GX_INDEX8 || desc == GX_INDEX16) && i >= GX_VA_POS) {
+      auto& array = g_gxState.arrays[i];
+      if (array.size == 0 && array.data != nullptr) {
+        u32 maxIdx = 0;
+        for (u32 v = 0; v < vtxCount; ++v) {
+          const u8* p = data + v * vtxSize + offset;
+          for (u32 k = 0; k < count; ++k) {
+            const u32 idx = desc == GX_INDEX16 ? (static_cast<u32>(p[k * 2]) << 8 | p[k * 2 + 1]) : p[k];
+            maxIdx = std::max(maxIdx, idx);
+          }
+        }
+        u64 extent = static_cast<u64>(maxIdx + 1) * std::max<u32>(array.stride, 1);
+        const auto* base = static_cast<const u8*>(array.data);
+        if (sUnknownArrayEnd != nullptr && base < sUnknownArrayEnd) {
+          extent = std::min<u64>(extent, static_cast<u64>(sUnknownArrayEnd - base));
+        }
+        if (extent > array.inferredSize) {
+          array.inferredSize = static_cast<u32>(extent);
+          array.cachedRange = {};
+          g_gxState.dirty |= DirtyImmediates;
+        }
+      }
+    }
+    offset += size;
+  }
+}
+
 static void push_gx_draw(GXPrimitive prim, GXVtxFmt fmt, u16 vtxCount, gfx::Range vertRange, gfx::Range idxRange,
                          u32 numIndices) noexcept {
   auto& state = g_gxState;
@@ -391,7 +444,8 @@ static void push_gx_draw(GXPrimitive prim, GXVtxFmt fmt, u16 vtxCount, gfx::Rang
     }
     auto& array = state.arrays[i];
     if (array.cachedRange.size == 0) {
-      array.cachedRange = gfx::push_storage(static_cast<const uint8_t*>(array.data), array.size);
+      array.cachedRange = gfx::push_storage(static_cast<const uint8_t*>(array.data),
+                                            array.size != 0 ? array.size : array.inferredSize);
     }
     immediates.arrayStart[i - GX_VA_POS] = array.cachedRange.offset;
   }
@@ -522,6 +576,7 @@ static void draw_prim(GXPrimitive prim, GXVtxFmt fmt, u16 vtxCount, ByteReader&
   if (totalVtxBytes > reader.remaining())
     UNLIKELY { handle_draw_overrun(totalVtxBytes, reader); }
   const auto vertexData = reader.take(totalVtxBytes);
+  infer_unknown_array_extents(fmt, vertexData.data(), vertexData.size() / std::max<u32>(vtxSize, 1), vtxSize);
 
   vtxCount = trunc_vtx_count(prim, vtxCount);
   if (vtxCount == 0)
@@ -633,6 +688,7 @@ void handle_aurora(ByteReader& reader) noexcept {
       array.size = arraySize;
       array.le = le;
       array.cachedRange = {};
+      array.inferredSize = 0;
       g_gxState.dirty |= DirtyImmediates;
     }
   } else if (subCmd == GX_AURORA_LOAD_TEXOBJ) {
@@ -833,3 +889,7 @@ void clear_draw_cache() noexcept {
 }
 
 } // namespace aurora::gx::fifo
