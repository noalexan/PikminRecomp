+ * PikminRecomp: arrays set with size 0 have their extent inferred from the indices each draw uses.
+ * The inferred extent never reaches past `end` (the end of the memory region holding the arrays).
+ */
+void AuroraSetUnknownArrayLimit(const void* end);
+
 AuroraReadbackStream AuroraReadbackCreateStream();
 void AuroraReadbackDestroyStream(AuroraReadbackStream stream);
 
diff --git a/lib/gx/command_processor.cpp b/lib/gx/command_processor.cpp
index e846a89..fcaaa67 100644
